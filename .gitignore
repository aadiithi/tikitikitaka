# Datasets and derived artefacts are never committed - the repo must stay
# clonable in seconds, and the raw data is redistributable only from its source.
!data/
features/
checkpoints/*.pt
!checkpoints/.gitkeep
results/*.csv
results/*.parquet

# Figures ARE committed: the README references them and a reviewer should see
# the results without running anything.
!results/*.png
!results/*.md
!results/headline.txt

__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/
.venv/
venv/
.env
.DS_Store
gradio_cached_examples/
flagged/

sid_export/
demo_set/
val2017/

